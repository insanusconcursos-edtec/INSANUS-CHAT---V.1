# --- OBRIGATÓRIO (Firebase) ---
# Copie do Console do Firebase -> Configurações do Projeto
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- OBRIGATÓRIO (Gemini AI) ---
# Obtenha em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- OPCIONAL (Integração Meta - WhatsApp/Instagram) ---
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
# Multi-tenant Tokens
META_TOKEN_INSANUS=
META_TOKEN_GABARITO=
META_TOKEN_ENEM=
# Multi-tenant Page IDs / Phone IDs
META_PAGE_ID_INSANUS=
META_PAGE_ID_GABARITO=
META_PAGE_ID_ENEM=

# --- CONFIGURAÇÃO DE AMBIENTE ---
# URL base do projeto (Ex: https://meu-projeto.vercel.app)
APP_URL=
NODE_ENV=production
